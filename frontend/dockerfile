FROM node:20-alpine

WORKDIR /app

# Copie des fichiers de config et package
COPY package.json pnpm-lock.yaml ./
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY postcss.config.js tailwind.config.js ./
COPY index.html ./
COPY public ./public

# Installation de pnpm
RUN npm install -g pnpm

# Installation des dépendances
RUN pnpm install

# Le code source sera monté par le volume, inutile de le copier ici

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]